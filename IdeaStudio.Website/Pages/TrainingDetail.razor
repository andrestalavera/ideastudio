@page "/fr/formations/{Slug}"
@page "/en/training/{Slug}"
@using IdeaStudio.Website.Components
@using IdeaStudio.Website.Models
@using IdeaStudio.Website.Services
@using System.Globalization
@inherits LocalizedComponent
@inject IContentGateway Content
@inject ILocalizedRoute LocalizedRoute
@layout MainLayout

<SeoHead Title="@seoTitle" Description="@seoDescription"
         CanonicalUrl="@seoCanonical" Locale="@seoLocale"
         HreflangUrls="@seoHreflang"
         SiteName="IdeaStud.io"
         NoIndex="@(loaded && training is null)"
         StructuredData="@seoStructuredData" />

@if (training is null)
{
    <Hero Kicker="404" Title="@notFoundTitle" Lead="@notFoundLead">
        <Actions>
            <ButtonLink Href="@LocalizedRoute.For("training")" Variant="primary" Label="@backLabel" />
        </Actions>
    </Hero>
}
else
{
    <Hero Kicker="@training.Category" Title="@training.Title" Lead="@training.Summary">
        <Actions>
            <ButtonLink Href="https://calendly.com/andres-talavera/30min" Variant="primary" External="true" Label="@bookLabel" />
            <ButtonLink Href="@LocalizedRoute.For("training")" Label="@backLabel" />
        </Actions>
    </Hero>

    @* Key facts *@
    <PageSection Rhythm="section" Bordered="false">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @{ int step = 0; }
            @foreach ((string label, string value) in Facts())
            {
                <Card data-reveal style="@($"--reveal-step:{step++}")">
                    <div class="label-mono">@label</div>
                    <div class="card-title">@value</div>
                </Card>
            }
        </div>
    </PageSection>

    @* Objectives + audience *@
    @if (training.Objectives is { Count: > 0 })
    {
        <PageSection Width="narrow">
            <ChapterBand Kicker="@objectivesKicker" Title="@objectivesTitle" />
            <ul class="ds-highlight-list mt-8">
                @for (int i = 0; i < training.Objectives.Count; i++)
                {
                    <li class="ds-highlight" data-reveal style="@($"--reveal-step:{i}")">
                        <span class="ds-highlight-mark" aria-hidden="true"></span>
                        <span>@training.Objectives[i]</span>
                    </li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(training.Audience))
            {
                <p class="mt-10 text-lead text-muted" data-reveal>
                    <span class="label-mono block mb-2">@audienceLabel</span>
                    @training.Audience
                </p>
            }
        </PageSection>
    }

    @* Programme, module by module *@
    @if (training.Modules is { Count: > 0 })
    {
        <PageSection Width="narrow">
            <ChapterBand Kicker="@agendaKicker" Title="@agendaTitle" />
            <ol class="ds-module-list mt-10">
                @for (int i = 0; i < training.Modules.Count; i++)
                {
                    TrainingModule module = training.Modules[i];
                    <li class="ds-module" data-reveal style="@($"--reveal-step:{i}")">
                        <div class="ds-module-head">
                            <span class="label-mono">@moduleLabel @((i + 1).ToString("D2", CultureInfo.InvariantCulture))</span>
                            @if (FormatModuleDuration(module.DurationDays) is string duration)
                            {
                                <span class="ds-training-card-pill">@duration</span>
                            }
                        </div>
                        <h3 class="ds-module-title">@module.Title</h3>
                        <ul class="ds-module-points">
                            @foreach (string point in module.Points)
                            {
                                <li>@point</li>
                            }
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(module.Workshop))
                        {
                            <p class="ds-module-workshop">
                                <span class="label-mono">@workshopLabel</span>
                                @module.Workshop
                            </p>
                        }
                    </li>
                }
            </ol>
        </PageSection>
    }

    @* How the course runs *@
    <PageSection Width="narrow">
        <ChapterBand Kicker="@formatKicker" Title="@formatTitle" />
        <ul class="ds-highlight-list mt-8">
            @for (int i = 0; i < formatPoints.Count; i++)
            {
                <li class="ds-highlight" data-reveal style="@($"--reveal-step:{i}")">
                    <span class="ds-highlight-mark" aria-hidden="true"></span>
                    <span>@formatPoints[i]</span>
                </li>
            }
        </ul>
        @if (!string.IsNullOrWhiteSpace(training.Evaluation))
        {
            <p class="mt-10 text-lead text-muted" data-reveal>
                <span class="label-mono block mb-2">@evaluationLabel</span>
                @training.Evaluation
            </p>
        }
    </PageSection>

    @* FAQ *@
    @if (training.Faq is { Count: > 0 })
    {
        <PageSection Width="narrow">
            <ChapterBand Kicker="@faqKicker" Title="@faqTitle" />
            <div class="mt-10">
                @for (int i = 0; i < training.Faq.Count; i++)
                {
                    FaqEntry entry = training.Faq[i];
                    <QABlock Kicker="@($"Q {i + 1:D2}")" Question="@entry.Question" Answer="@entry.Answer" Step="@i" />
                }
            </div>
        </PageSection>
    }

    @* Same family *@
    @if (related is { Count: > 0 })
    {
        <PageSection>
            <ChapterBand Kicker="@relatedKicker" Title="@relatedTitle" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
                @for (int i = 0; i < related.Count; i++)
                {
                    Training other = related[i];
                    <a class="ds-tile" href="@($"{LocalizedRoute.For("training")}/{other.Slug}")" data-reveal style="@($"--reveal-step:{i}")">
                        <span class="label-mono">@FormatTrainingFacts(other)</span>
                        <span class="card-title">@other.Title</span>
                        <span class="text-muted">@other.Summary</span>
                    </a>
                }
            </div>
        </PageSection>
    }

    @* CTA *@
    <PageSection Rhythm="section">
        <ChapterBand Kicker="@ctaKicker" Title="@ctaTitle" Lead="@ctaLead" />
        <div class="row mt-chapter" data-reveal>
            <ButtonLink Href="https://calendly.com/andres-talavera/30min" Variant="primary" External="true" Label="@bookLabel" />
            <ButtonLink Href="@LocalizedRoute.For("contact")" Label="@contactLabel" />
        </div>
    </PageSection>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private Training? training;
    private IReadOnlyList<Training>? related;
    private bool loaded;
    private string seoTitle = "Formation, IdeaStud.io";
    private string seoDescription = "";
    private string seoCanonical = "https://ideastud.io/fr/formations";
    private string seoLocale = "fr_FR";
    private Dictionary<string, string>? seoHreflang;
    private List<string>? seoStructuredData;

    private string objectivesKicker = "Objectifs";
    private string objectivesTitle = "Ce que vous saurez faire.";
    private string agendaKicker = "Au programme";
    private string agendaTitle = "Le programme, module par module.";
    private string moduleLabel = "Module";
    private string workshopLabel = "Atelier";
    private string formatKicker = "Déroulé";
    private string formatTitle = "Comment la formation se passe.";
    private List<string> formatPoints = new();
    private string evaluationLabel = "Évaluation";
    private string faqKicker = "Questions fréquentes";
    private string faqTitle = "Ce que les équipes demandent.";
    private string relatedKicker = "Dans la même famille";
    private string relatedTitle = "Pour aller plus loin.";
    private string ctaKicker = "Sur-mesure";
    private string ctaTitle = "Cette formation pour votre équipe ?";
    private string ctaLead = "";
    private string bookLabel = "Réserver un échange";
    private string contactLabel = "Me contacter";
    private string backLabel = "Toutes les formations";
    private string notFoundTitle = "Formation introuvable.";
    private string notFoundLead = "Cette formation n'existe pas. Retour au catalogue.";

    // Fact labels
    private string levelLabel = "Niveau";
    private string durationLabel = "Durée";
    private string audienceLabel = "Pour qui";
    private string prereqLabel = "Prérequis";
    private string certLabel = "Certification visée";

    private bool Fr => CultureService.CurrentCulture.Name.StartsWith("fr");

    protected override async Task LoadLocalizedStringsAsync()
    {
        await base.LoadLocalizedStringsAsync();
        await LoadAsync();
        GenerateStructuredData();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        GenerateStructuredData();
    }

    protected override void LoadTexts()
    {
        bool fr = Fr;
        seoLocale = fr ? "fr_FR" : "en_US";
        objectivesKicker = fr ? "Objectifs" : "Objectives";
        objectivesTitle  = fr ? "Ce que vous saurez faire." : "What you'll be able to do.";
        agendaKicker = fr ? "Au programme" : "Curriculum";
        agendaTitle  = fr ? "Le programme, module par module." : "The programme, module by module.";
        moduleLabel   = fr ? "Module" : "Module";
        workshopLabel = fr ? "Atelier" : "Hands-on";
        formatKicker = fr ? "Déroulé" : "How it runs";
        formatTitle  = fr ? "Comment la formation se passe." : "How the course runs.";
        formatPoints = fr
            ? new() {
                "En présentiel, en classe virtuelle synchrone ou en intra sur-mesure, dans vos locaux comme à distance.",
                "Alternance de démonstrations et d'exercices sur machine, avec un atelier fil rouge repris de module en module.",
                "Supports de cours et code des exercices remis aux participants, à garder après la session.",
            }
            : new() {
                "On-site, in a synchronous virtual classroom or as a bespoke in-house session, at your offices or remote.",
                "Demonstrations alternating with hands-on exercises, around a thread carried from module to module.",
                "Course materials and exercise code handed to participants, theirs to keep after the session.",
            };
        evaluationLabel = fr ? "Évaluation" : "Assessment";
        faqKicker = fr ? "Questions fréquentes" : "FAQ";
        faqTitle  = fr ? "Ce que les équipes demandent." : "What teams ask.";
        relatedKicker = fr ? "Dans la même famille" : "Same family";
        relatedTitle  = fr ? "Pour aller plus loin." : "To go further.";
        ctaKicker = fr ? "Sur-mesure" : "Bespoke";
        ctaTitle  = fr ? "Cette formation pour votre équipe ?" : "This training for your team?";
        ctaLead   = fr
            ? "En présentiel, classe virtuelle ou intra sur-mesure. Parlons de votre contexte et de votre calendrier."
            : "On-site, virtual classroom or bespoke in-house. Let's talk about your context and timeline.";
        bookLabel    = fr ? "Réserver un échange" : "Book a call";
        contactLabel = fr ? "Me contacter" : "Contact me";
        backLabel    = fr ? "Toutes les formations" : "All training";
        notFoundTitle = fr ? "Formation introuvable." : "Training not found.";
        notFoundLead  = fr ? "Cette formation n'existe pas. Retour au catalogue." : "That training doesn't exist. Back to the catalogue.";
        levelLabel    = fr ? "Niveau" : "Level";
        durationLabel = fr ? "Durée" : "Duration";
        audienceLabel = fr ? "Pour qui" : "Who it's for";
        prereqLabel   = fr ? "Prérequis" : "Prerequisites";
        certLabel     = fr ? "Certification visée" : "Target certification";
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(Slug)) { training = null; return; }
        bool fr = Fr;
        IReadOnlyList<Training> all = await Content.GetTrainingsAsync(CultureService.CurrentCulture.Name);
        training = all.FirstOrDefault(t => string.Equals(t.Slug, Slug, StringComparison.OrdinalIgnoreCase));
        loaded = true;
        if (training is not null)
        {
            related = all
                .Where(t => t.Category == training.Category && t.Slug != training.Slug)
                .Take(3)
                .ToList();
            seoTitle = $"{training.Title} | {(fr ? "Formation" : "Training")} — Andrés Talavera | IdeaStud.io";
            seoDescription = training.Summary;
            string slug = training.Slug;
            seoCanonical = $"https://ideastud.io{LocalizedRoute.For("training", fr ? "fr" : "en")}/{slug}";
            string frUrl = $"https://ideastud.io{LocalizedRoute.For("training", "fr")}/{slug}";
            string enUrl = $"https://ideastud.io{LocalizedRoute.For("training", "en")}/{slug}";
            seoHreflang = new Dictionary<string, string> { ["fr"] = frUrl, ["en"] = enUrl, ["x-default"] = frUrl };
        }
    }

    private IEnumerable<(string, string)> Facts()
    {
        if (training is null) { yield break; }
        if (!string.IsNullOrWhiteSpace(training.Level)) { yield return (levelLabel, LevelLabel(training.Level!)); }
        if (training.DurationDays is int d) { yield return (durationLabel, Fr ? $"{d} jour{(d > 1 ? "s" : "")}" : $"{d} day{(d > 1 ? "s" : "")}"); }
        if (!string.IsNullOrWhiteSpace(training.Prerequisites)) { yield return (prereqLabel, training.Prerequisites!); }
        if (!string.IsNullOrWhiteSpace(training.Certification)) { yield return (certLabel, training.Certification!); }
    }

    private string LevelLabel(string level) => level.ToLowerInvariant() switch
    {
        "foundation" => Fr ? "Fondamentaux" : "Foundation",
        "intermediate" => Fr ? "Intermédiaire" : "Intermediate",
        "advanced" => Fr ? "Avancé" : "Advanced",
        _ => level,
    };

    // Modules are sized in quarters of a day; fractions read better as glyphs than as decimals.
    private string? FormatModuleDuration(double? days) => days switch
    {
        null => null,
        <= 0 => null,
        0.25 => Fr ? "¼ j" : "¼d",
        0.5 => Fr ? "½ j" : "½d",
        0.75 => Fr ? "¾ j" : "¾d",
        _ => Fr ? $"{days.Value.ToString("0.##", CultureInfo.GetCultureInfo("fr-FR"))} j"
                : $"{days.Value.ToString("0.##", CultureInfo.InvariantCulture)}d",
    };

    private string FormatTrainingFacts(Training t)
    {
        List<string> parts = new();
        if (t.DurationDays is int d) { parts.Add(Fr ? $"{d} j" : $"{d}d"); }
        if (!string.IsNullOrWhiteSpace(t.Level)) { parts.Add(LevelLabel(t.Level!)); }
        if (!string.IsNullOrWhiteSpace(t.Certification)) { parts.Add(t.Certification!); }
        return string.Join(" · ", parts);
    }

    private void GenerateStructuredData()
    {
        if (training is null) { seoStructuredData = null; return; }
        bool fr = Fr;
        string cultureCode = fr ? "fr" : "en";

        string? workload = training.DurationDays is int d ? $"P{d}D" : null;
        SchemaOrg.Course course = new(
            Name: training.Title,
            Description: training.Summary,
            Provider: SchemaIdentity.Organization(),
            CourseCode: training.Slug,
            EducationalLevel: training.Level,
            TimeRequired: workload,
            Url: seoCanonical,
            Id: $"{seoCanonical}#course",
            InLanguage: cultureCode,
            // No per-course price and no credential awarded: modules prepare for exams, they don't certify.
            Offers: new SchemaOrg.CourseOffer("Paid"),
            HasCourseInstance: new SchemaOrg.CourseInstance(
                CourseMode: ["Onsite", "Online"],
                CourseWorkload: workload,
                Instructor: SchemaIdentity.PersonRef()),
            SyllabusSections: training.Modules
                .Select(m => new SchemaOrg.Syllabus(
                    Name: m.Title,
                    Description: string.Join(" · ", m.Points),
                    TimeRequired: ToIso8601(m.DurationDays)))
                .ToArray());

        List<string> blocks = new()
        {
            SchemaOrg.ToJsonLd(course),
            SchemaOrg.ToJsonLd(SchemaOrg.CreateBreadcrumb(
                "https://ideastud.io",
                (fr ? "Accueil" : "Home", LocalizedRoute.For("home", cultureCode)),
                (fr ? "Formations" : "Training", LocalizedRoute.For("training", cultureCode)),
                (training.Title, $"{LocalizedRoute.For("training", cultureCode)}/{training.Slug}"))),
        };

        if (training.Faq is { Count: > 0 })
        {
            blocks.Add(SchemaOrg.ToJsonLd(new SchemaOrg.FAQPage(
                training.Faq.Select(f => new SchemaOrg.Question(f.Question, new SchemaOrg.Answer(f.Answer))).ToArray())));
        }

        seoStructuredData = blocks;
    }

    // Quarter-day modules, expressed as ISO 8601 hours on a 7-hour training day.
    private static string? ToIso8601(double? days) =>
        days is null or <= 0 ? null : $"PT{(int)Math.Round(days.Value * 7)}H";
}
